# Copy to .dev.vars for local development. Never commit .dev.vars.
HOST_PASSWORD=change-me

# The real models: Claude Haiku 5.5 narrates, Cloudflare's Clef decides.
# Clef runs on your Cloudflare account through the AI binding (no key needed).
NARRATOR_API_KEY=

