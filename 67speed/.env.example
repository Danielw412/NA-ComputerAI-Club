# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# .env.local is gitignored via the "*.local" rule — never commit real values.
#
# The anon key is designed to be public; Row Level Security is what protects the
# table. See CLAUDE.md section 7 for the schema and policies.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
