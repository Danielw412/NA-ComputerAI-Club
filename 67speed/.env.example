# Required for the shared Supabase leaderboard used in production.
# Copy to .env.local for local dev; .env* is gitignored except this example.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only. New deployments should use VITE_SUPABASE_PUBLISHABLE_KEY.
# Publishable keys (sb_publishable_*) go in the apikey header only; legacy anon
# keys are JWTs and additionally use Authorization: Bearer. See src/lib/leaderboard.ts.
# VITE_SUPABASE_ANON_KEY=
